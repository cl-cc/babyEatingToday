page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFFBF8;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  padding-bottom: 10%;
}

.tab-switch {
  display: flex;
  margin-bottom: 24rpx;
  background: #F2EBE6;
  border-radius: 999rpx;
  padding: 6rpx;
}

.tab-switch-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #888888;
}

.tab-switch-item--on {
  background: #FFFFFF;
  color: #FF6B6B;
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.cat-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
  width: 100%;
}

.cat-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  background: #FFF6F2;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #888888;
}

.cat-chip--on {
  background: #FF6B6B;
  color: #fff;
}

.food-group {
  margin-bottom: 8rpx;
}

.food-group__head {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  padding: 0 8rpx;
}

.food-group__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #333333;
}

.food-grid--input {
  margin-bottom: 24rpx;
}

/* 食材三列网格 — 独立样式，不依赖全局 tag-food */
.food-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  width: 100%;
  margin-bottom: 8rpx;
}

.food-cell {
  width: 33.33%;
  padding: 8rpx;
  box-sizing: border-box;
}

.food-chip {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 72rpx;
  padding: 0 16rpx;
  background: #FFF6F2;
  border-radius: 36rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.food-chip--on {
  background: #FFF0ED;
}

.food-chip__emoji {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 1;
  margin-right: 6rpx;
}

.food-chip__name {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
}

.food-chip--on .food-chip__name {
  color: #FF6B6B;
  font-weight: 600;
}

.food-chip__check {
  flex-shrink: 0;
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  color: #fff;
  background: #FF6B6B;
  border-radius: 50%;
  margin-left: 4rpx;
}

.food-chip--custom {
  border: 1rpx dashed #FFCCDD;
  padding-right: 44rpx;
}

.food-chip__delete {
  position: absolute;
  right: 10rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 32rpx;
  height: 32rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 28rpx;
  color: #E85A7A;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid #FFD6E5;
  border-radius: 50%;
  z-index: 2;
  flex-shrink: 0;
}

.food-chip__delete:active {
  background: #FFF0F5;
  opacity: 0.85;
}

.food-cell--input {
  width: 66.66%;
}

.food-chip--input {
  background: #FFFFFF;
  border: 2rpx solid #FFE0EA;
  padding-right: 8rpx;
}

.food-chip__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 24rpx;
  color: #333333;
}

.dish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F2EBE6;
}

.dish-row:last-child {
  border-bottom: none;
}

.dish-row__main {
  flex: 1;
  min-width: 0;
}

.dish-row__label {
  font-size: 24rpx;
  color: #888888;
  display: block;
  margin-bottom: 4rpx;
}

.dish-row__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.dish-row__cal {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #FF6B6B;
  background: #FFF0F5;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

.total-cal-bar {
  text-align: center;
  font-size: 26rpx;
  color: #888888;
  padding: 20rpx;
  margin: 12rpx 0;
  background: #FFF6F2;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.total-cal-num {
  font-size: 34rpx;
  font-weight: 800;
  color: #FF6B6B;
}

.seasoning-block {
  background: #FFFAFC;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin: 12rpx 0 16rpx;
  border: 1rpx solid #FFE0EA;
}

.seasoning-block--meal {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
}

.seasoning-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #FF6B6B;
  margin-bottom: 12rpx;
}

.seasoning-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #FFF0F5;
}

.seasoning-item:last-child {
  border-bottom: none;
}

.seasoning-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
}

.seasoning-amount {
  font-size: 24rpx;
  color: #888888;
  margin-left: 16rpx;
}

.method-block {
  background: #EDFAF6;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin: 12rpx 0 16rpx;
  border: 1rpx solid #C8E8DF;
}

.method-block--meal {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
}

.method-block .seasoning-title {
  color: #3A8A78;
}

.method-block .reason-list {
  margin-top: 0;
}

.meal-result {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F2EBE6;
}

.meal-result:last-of-type {
  border-bottom: none;
  margin-bottom: 8rpx;
}

.meal-result__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.meal-result__label {
  font-size: 28rpx;
  font-weight: 700;
  color: #FF6B6B;
}

.meal-result__cal {
  font-size: 24rpx;
  font-weight: 600;
  color: #FF6B6B;
  background: #FFF0F5;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.meal-result__name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.action-btn {
  margin-bottom: 20rpx;
}

.why-title {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
  color: #333333;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-top: 16rpx;
  text-align: center;
  padding: 16rpx;
  background: #FFF6F2;
  border-radius: 24rpx;
}

.ai-hint {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 12rpx;
}