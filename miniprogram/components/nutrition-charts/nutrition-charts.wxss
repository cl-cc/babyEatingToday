.charts-panel {
  margin: 24rpx 0;
  padding: 28rpx 24rpx;
  background: linear-gradient(160deg, #FFF8FB 0%, #FFFFFF 100%);
  border: 2rpx solid #FFE4EC;
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 28rpx rgba(255, 105, 135, 0.1);
  box-sizing: border-box;
}

.charts-panel__head {
  margin-bottom: 20rpx;
}

.charts-panel__title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #E85A7A;
  line-height: 1.3;
}

.charts-panel__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #D48BA0;
}

.chart-block {
  margin-bottom: 28rpx;
}

.chart-block:last-child {
  margin-bottom: 0;
}

.chart-block__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5C3D4A;
  margin-bottom: 12rpx;
}

.chart-ec-wrap {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.chart-ec {
  display: block;
  width: 100%;
}

.chart-ec--pie {
  height: 420rpx;
}

.chart-ec--bar {
  height: 460rpx;
}
