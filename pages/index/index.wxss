/**pages/index/index.wxss**/

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FFF5F8;
}

.warm-tip {
  position: fixed;
  top: 6%;
  left: 6%;
  z-index: 20;
  max-width: 88%;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
  color: #E85A7A;
  background: linear-gradient(135deg, rgba(255, 248, 251, 0.96) 0%, rgba(255, 240, 246, 0.94) 100%);
  border: 2rpx solid #FFD6E5;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 105, 135, 0.14);
  letter-spacing: 0.5rpx;
  line-height: 1.45;
  box-sizing: border-box;
  opacity: 1;
  transform: translateY(0) scale(1);
  transition: opacity 0.32s ease, transform 0.32s ease;
}

.warm-tip--hide {
  opacity: 0;
  transform: translateY(12rpx) scale(0.96);
  pointer-events: none;
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;

}

.top-bg {
  width: 70rpx;
  height: 70rpx;
  position: absolute;
  right: 5%;
  top: 25%;
}

.index-page {
  /* background: linear-gradient(180deg, #FFF0F5 0%, #FFF8FA 40%, #FFF5F8 100%); */
}

.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #D48BA0;
  margin-bottom: 16rpx;
}

.gender-section {
  padding-top: 8rpx;
  margin-bottom: 8rpx;
}

.gender-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.gender-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx 20rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  border: 2rpx solid #FFE4EC;
  box-shadow: 0 4rpx 20rpx rgba(255, 105, 135, 0.08);
  box-sizing: border-box;
  transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
}

.gender-card:active {
  opacity: 0.88;
}

.gender-avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  /* background: #FFF5F9; */
  /* border: 4rpx solid #FFE8F0; */
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.gender-avatar {
  width: 100%;
  height: 100%;
}

.gender-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #B8889A;
}

.index-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  padding: 12rpx 0 20rpx;
  text-align: left;
}

.index-header__left {
  width: 120rpx;
  flex-shrink: 0;
}

.index-header__avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: block;
}

.index-header__right {
  flex: 1;
  min-width: 0;
  text-align: left;
}

.today-advice__line {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #5C3D4A;
  line-height: 1.5;
  word-break: break-all;
}

.page-header-sub {
  display: block;
  font-size: 24rpx;
  color: #F0A0B8;
  margin-top: 10rpx;
  line-height: 1.4;
}

.today-advice__loading {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.today-advice__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF8FAB;
  animation: advice-pulse 1s ease-in-out infinite;
}

.today-advice__loading-text {
  font-size: 26rpx;
  color: #D48BA0;
}

@keyframes advice-pulse {

  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.85);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }
}

.age-check-section {
  margin-bottom: 20rpx;
}

.age-check-row {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.age-summary {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  border: 2rpx solid #FFE4EC;
  box-shadow: 0 4rpx 20rpx rgba(255, 105, 135, 0.08);
  transition: box-shadow 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  box-sizing: border-box;
}

.checkin-card {
  width: 148rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 14rpx 2rpx;
  min-height: 0;
  background: linear-gradient(160deg, #FFF8FB 0%, #FFFFFF 100%);
  border-radius: var(--radius-lg);
  border: 2rpx solid #FFD6E5;
  box-shadow: 0 4rpx 20rpx rgba(255, 105, 135, 0.1);
  box-sizing: border-box;
  position: relative;
  overflow: visible;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.checkin-card--pressed {
  transform: scale(0.96);
}

.checkin-card--done {
  background: linear-gradient(160deg, #FFF0F6 0%, #FFFFFF 100%);
  border-color: #FFB8CC;
}

.checkin-card--loading {
  opacity: 0.85;
}

.checkin-card__confetti {
  position: absolute;
  left: 50%;
  top: 42%;
  width: 0;
  height: 0;
  z-index: 5;
  pointer-events: none;
}

.checkin-confetti__item {
  position: absolute;
  left: 0;
  top: 0;
  font-size: 30rpx;
  line-height: 1;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0.2);
  animation: checkin-confetti-pop 1.1s ease-out forwards;
}

.checkin-card__status {
  font-size: 26rpx;
  font-weight: 700;
  color: #E85A7A;
  line-height: 1.2;
  text-align: center;
}

.checkin-card__count {
  font-size: 20rpx;
  color: #D48BA0;
  margin-top: 6rpx;
  line-height: 1.2;
  text-align: center;
}

.age-summary--pressed {
  transform: scale(0.985);
  box-shadow: 0 2rpx 12rpx rgba(255, 105, 135, 0.1);
}

@keyframes checkin-confetti-pop {
  0% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(0.2);
  }

  55% {
    opacity: 1;
    transform: translate(calc(-50% + var(--tx)), calc(-50% + var(--ty))) scale(1.15);
  }

  100% {
    opacity: 0;
    transform: translate(calc(-50% + var(--tx) * 1.15), calc(-50% + var(--ty) * 1.15 + 36rpx)) scale(0.85);
  }
}

.age-summary__main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.age-summary__label {
  font-size: 26rpx;
  font-weight: 600;
  color: #D48BA0;
  flex-shrink: 0;
}

.age-summary__value {
  font-size: 28rpx;
  font-weight: 700;
  color: #E85A7A;
  white-space: nowrap;
}

.age-summary__action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.age-summary__hint {
  font-size: 22rpx;
  color: #C8A0B0;
  white-space: nowrap;
  margin-right: 10rpx;
}

.age-summary__arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #E8A8C0;
  border-bottom: 3rpx solid #E8A8C0;
  transform: rotate(45deg);
  transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  margin-top: -4rpx;
}

.age-summary__arrow--open {
  transform: rotate(-135deg);
  margin-top: 4rpx;
}

.age-panel {
  overflow: hidden;
  transition: height 0.38s cubic-bezier(0.4, 0, 0.2, 1);
}

.age-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx 0 8rpx;
  box-sizing: border-box;
}

.age-chip {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-radius: var(--radius);
  font-size: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 105, 135, 0.08);
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  border: 2rpx solid #FFE4EC;
  transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease;
}

.age-expanded .age-chip {
  animation: age-chip-in 0.36s cubic-bezier(0.4, 0, 0.2, 1) backwards;
}

.age-expanded .age-chip:nth-child(1) {
  animation-delay: 0.04s;
}

.age-expanded .age-chip:nth-child(2) {
  animation-delay: 0.08s;
}

.age-expanded .age-chip:nth-child(3) {
  animation-delay: 0.12s;
}

.age-expanded .age-chip:nth-child(4) {
  animation-delay: 0.16s;
}

.age-expanded .age-chip:nth-child(5) {
  animation-delay: 0.2s;
}

@keyframes age-chip-in {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.96);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.age-chip--on {
  background: #FFF0F5;
  color: #E85A7A;
  font-weight: 600;
  border-color: #FFB8CC;
}

/* 粉色内容块 */
.today-bubble {
  background: linear-gradient(160deg, #FFF5F9 0%, #FFFFFF 55%, #FFF8FB 100%);
  border: 2rpx solid #FFD6E5;
  box-shadow: 0 10rpx 40rpx rgba(255, 105, 135, 0.14);
  margin-bottom: 28rpx;
}

.random-bubble {
  background: linear-gradient(160deg, #FFF0F6 0%, #FFFFFF 55%, #FFF5FA 100%);
  border: 2rpx solid #FFCCD9;
  box-shadow: 0 10rpx 40rpx rgba(255, 120, 150, 0.12);
}

.bubble-title--pink {
  color: #E85A7A;
}

.cute-divider--pink {
  background: linear-gradient(90deg, transparent, #FFD6E5, transparent);
  height: 2rpx;
}

.food-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.food-card {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 20rpx 18rpx;
  background: #FFFFFF;
  border-radius: var(--radius);
  border: 2rpx solid #FFE8F0;
  box-shadow: 0 4rpx 16rpx rgba(255, 105, 135, 0.06);
}

.food-card__head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  min-width: 0;
}

.food-card__emoji {
  font-size: 40rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.food-card__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #5C3D4A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.food-card__amount {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.food-card__amount-label {
  font-size: 22rpx;
  color: #C8A0B0;
}

.food-card__amount-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #E85A7A;
}

.food-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.food-tag {
  font-size: 20rpx;
  color: #D48BA0;
  background: #FFF0F5;
  padding: 6rpx 12rpx;
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.nutri-section {
  background: #FFFAFC;
  border-radius: var(--radius);
  padding: 24rpx 16rpx 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #FFE0EA;
}

.nutri-section__title {
  display: block;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #E85A7A;
  margin-bottom: 20rpx;
}

.nutri-rings {
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.nutri-ring-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.nutri-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.nutri-ring__inner {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 8rpx rgba(255, 105, 135, 0.06);
}

.nutri-ring__pct {
  font-size: 24rpx;
  font-weight: 800;
  color: #E85A7A;
}

.nutri-ring__label {
  font-size: 22rpx;
  color: #B8889A;
  font-weight: 600;
}

.meal-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #FFE8F0;
}

.meal-tag {
  font-size: 24rpx;
  color: #D48BA0;
  background: #FFF5F9;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
}

.seasoning-block {
  background: #FFFAFC;
  border-radius: var(--radius);
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #FFE0EA;
}

.seasoning-block--meal {
  margin-top: 12rpx;
  margin-bottom: 0;
  padding: 16rpx 20rpx;
}

.seasoning-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #E85A7A;
  margin-bottom: 12rpx;
}

.seasoning-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #FFF0F5;
}

.seasoning-item:last-child {
  border-bottom: none;
}

.seasoning-name {
  font-size: 26rpx;
  color: #5C3D4A;
  font-weight: 600;
}

.seasoning-amount {
  font-size: 24rpx;
  color: #D48BA0;
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.tip-text {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #D48BA0;
  margin-bottom: 16rpx;
  padding: 16rpx 24rpx;
  background: #FFF5F9;
  border-radius: var(--radius);
}

.refresh-btn {
  margin-top: 8rpx;
}

.random-btn {
  margin-top: 16rpx;
}

.meal-block {
  margin-bottom: 28rpx;
  padding: 16rpx 8rpx;
  border-bottom: 1rpx solid #FFE8F0;
}

.meal-block:last-child {
  border-bottom: none;
  margin-bottom: 8rpx;
}

.meal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.meal-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #E85A7A;
}

.meal-total-cal {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF6B8A;
  background: #FFF0F5;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
}

.meal-food-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 8rpx;
}

.meal-food-name {
  font-size: 26rpx;
  color: #5C3D4A;
  flex: 1;
}

.meal-food-cal {
  font-size: 24rpx;
  color: #FF6B8A;
  font-weight: 600;
  margin-left: 16rpx;
}

/* AI 调用动画 */
.ai-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx 40rpx;
}

.ai-loading--compact {
  padding: 32rpx 24rpx 24rpx;
}

.ai-loading-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FFE0EA;
  border-top-color: #FF6B8A;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: ai-spin 1s linear infinite;
  margin-bottom: 28rpx;
}

.ai-loading-ring--sm {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
}

.ai-loading-core {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFB8CC 0%, #FF6B8A 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: ai-spin 1s linear infinite reverse;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 138, 0.3);
}

.ai-loading-ring--sm .ai-loading-core {
  width: 56rpx;
  height: 56rpx;
  font-size: 22rpx;
}

.ai-loading-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #E85A7A;
  margin-bottom: 8rpx;
}

.ai-loading-sub {
  font-size: 24rpx;
  color: #F0A0B8;
  margin-bottom: 20rpx;
}

.ai-loading-dots {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.ai-loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FF8FAB;
  animation: ai-bounce 1.2s ease-in-out infinite;
}

.ai-loading-dot--2 {
  animation-delay: 0.15s;
}

.ai-loading-dot--3 {
  animation-delay: 0.3s;
}

@keyframes ai-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes ai-bounce {

  0%,
  80%,
  100% {
    transform: scale(0.6);
    opacity: 0.4;
  }

  40% {
    transform: scale(1);
    opacity: 1;
  }
}