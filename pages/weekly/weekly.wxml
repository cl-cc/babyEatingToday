  <text class="export-fab__icon">{{exporting ? '⏳' : '📸'}}</text>
  <text class="export-fab__text">{{exporting ? '导出中' : '导出'}}</text>
</view> -->

<canvas wx:if="{{showExportCanvas}}" type="2d" id="weeklyExportCanvas" class="export-canvas"></canvas>
<tab-bar id="tabBar"></tab-bar>