.beam-btn {
  position: relative;
  width: 100%;
  border-radius: 999rpx;
  overflow: hidden;
  box-sizing: border-box;
  padding: 5rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 138, 0.22);
}

.beam-btn__palette {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.5;
  background:
    radial-gradient(ellipse 100rpx 48rpx at 18% 50%, rgba(255, 80, 120, 0.55), transparent 72%),
    radial-gradient(ellipse 100rpx 48rpx at 82% 50%, rgba(100, 90, 255, 0.5), transparent 72%),
    radial-gradient(ellipse 72rpx 36rpx at 50% 0%, rgba(60, 150, 255, 0.45), transparent 72%),
    radial-gradient(ellipse 72rpx 36rpx at 50% 100%, rgba(60, 200, 130, 0.42), transparent 72%);
}

.beam-btn__glow,
.beam-btn__bloom {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 280%;
  height: 280%;
  z-index: 1;
  pointer-events: none;
  background: conic-gradient(
    from 0deg,
    transparent 0deg,
    transparent 248deg,
    rgba(255, 80, 120, 0.04) 262deg,
    rgba(255, 80, 120, 0.28) 276deg,
    rgba(60, 150, 255, 0.38) 286deg,
    rgba(255, 255, 255, 0.5) 294deg,
    rgba(80, 210, 140, 0.34) 302deg,
    rgba(170, 80, 240, 0.28) 310deg,
    rgba(255, 120, 80, 0.12) 322deg,
    transparent 336deg,
    transparent 360deg
  );
}

.beam-btn__bloom {
  z-index: 0;
  opacity: 0.55;
  filter: blur(14rpx);
}

.beam-btn__inner {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.beam-btn__text {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.beam-btn--primary .beam-btn__inner {
  background: linear-gradient(135deg, #FF9A8B 0%, #FF6B6B 100%);
  box-shadow: inset 0 2rpx 8rpx rgba(255, 255, 255, 0.22);
}

.beam-btn--primary .beam-btn__text {
  color: #FFFFFF;
  text-shadow: 0 2rpx 6rpx rgba(160, 50, 50, 0.2);
}

.beam-btn--pink .beam-btn__inner {
  background: linear-gradient(135deg, #FF9EB5 0%, #FF6B8A 100%);
  box-shadow: inset 0 2rpx 8rpx rgba(255, 255, 255, 0.25);
}

.beam-btn--pink .beam-btn__text {
  color: #FFFFFF;
  text-shadow: 0 2rpx 6rpx rgba(180, 40, 80, 0.25);
}

.beam-btn--outline .beam-btn__inner {
  background: #FFFFFF;
  box-shadow: inset 0 0 0 2rpx #FFE0EA;
}

.beam-btn--outline .beam-btn__text {
  color: #E85A7A;
}

.beam-btn--outline {
  box-shadow: 0 6rpx 20rpx rgba(255, 105, 135, 0.12);
}

.beam-btn--pressed .beam-btn__inner {
  opacity: 0.92;
  transform: scale(0.985);
}

.beam-btn--disabled {
  pointer-events: none;
}

.beam-btn--disabled .beam-btn__glow,
.beam-btn--disabled .beam-btn__bloom {
  opacity: 0.28;
}

.beam-btn--disabled .beam-btn__palette {
  opacity: 0.25;
}

.beam-btn--disabled .beam-btn__inner {
  opacity: 0.72;
}
