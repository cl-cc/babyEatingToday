/**app.wxss — 轻柔可爱风**/

page {
  --bg: #FFFBF8;
  --surface: #FFFFFF;
  --surface-soft: #FFF6F2;
  --primary: #FF6B6B;
  --primary-light: #FFF0ED;
  --primary-grad: linear-gradient(135deg, #FF9A8B 0%, #FF6B6B 100%);
  --mint: #5ECFB8;
  --mint-light: #EDFAF6;
  --mint-grad: linear-gradient(135deg, #7EDFC9 0%, #5ECFB8 100%);
  --peach: #FFB088;
  --peach-light: #FFF4EE;
  --yellow: #FFD93D;
  --text: #333333;
  --text-2: #888888;
  --text-3: #BBBBBB;
  --line: #F2EBE6;
  --radius: 24rpx;
  --radius-lg: 32rpx;
  --radius-pill: 999rpx;
  --shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
  --shadow-btn: 0 8rpx 24rpx rgba(255, 107, 107, 0.28);
  --tab-bar-inset: calc(116rpx + env(safe-area-inset-bottom));

  background: var(--bg);
  font-family: 'PingFang SC', -apple-system, sans-serif;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.5;
}

/* 内容面板 */
.bubble {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 36rpx 32rpx;
  box-shadow: var(--shadow);
  margin-bottom: 24rpx;
}

.bubble-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text);
  text-align: center;
}

/* 分隔线 */
.cute-divider {
  height: 1rpx;
  background: var(--line);
  margin: 28rpx 0;
}
/* 按钮 */
.btn-cute {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  background: var(--primary-grad);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-pill);
  border: none;
  box-shadow: var(--shadow-btn);
}

.btn-cute::after { border: none; }

.btn-cute--hover {
  opacity: 0.88;
  transform: scale(0.98);
}

.btn-cute--secondary {
  background: var(--mint-grad);
  box-shadow: 0 8rpx 24rpx rgba(94, 207, 184, 0.3);
}

.btn-cute--outline {
  background: var(--surface);
  color: var(--primary);
  box-shadow: none;
  border: 2rpx solid var(--line);
}

/* 页面框架 */
.page-wrap {
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
  box-sizing: border-box;
}

.page-header {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.page-header-emoji {
  font-size: 88rpx;
  display: block;
  margin-bottom: 12rpx;
  line-height: 1.1;
}

.page-header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 1rpx;
}

.page-header-sub {
  font-size: 24rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}

/* 食材标签 */
.tag-food {
  display: inline-flex;
  align-items: center;
  padding: 16rpx 28rpx;
  margin: 8rpx;
  background: var(--surface-soft);
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  color: var(--text);
  transition: all 0.2s ease;
}

.tag-food--selected {
  background: var(--primary-light);
  color: var(--primary);
  font-weight: 600;
}

.tag-food-emoji {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 勾选 */
.check-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #fff;
  background: var(--surface);
}

.check-icon--on {
  background: var(--mint);
  border-color: var(--mint);
}

/* 结果 */
.result-block { margin-top: 8rpx; }

.result-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  font-size: 28rpx;
}

.result-label {
  color: var(--text-2);
  width: 100rpx;
  flex-shrink: 0;
}

.result-value {
  font-weight: 600;
  flex: 1;
  color: var(--text);
}

.reason-list { margin-top: 8rpx; }

.reason-item {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  background: var(--mint-light);
  border-radius: var(--radius);
  color: #3A8A78;
}

.reason-check {
  margin-right: 10rpx;
  font-size: 24rpx;
}

.loading-wrap {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-2);
}

.loading-emoji {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
}

.stars-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  margin: 28rpx 0;
}

.star-on { color: var(--yellow); font-size: 36rpx; }
.star-off { color: #EDE8E4; font-size: 36rpx; }
